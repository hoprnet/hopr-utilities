{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays",
    "group:allNonMajor",
    "group:allDigest",
    ":disableDependencyDashboard"
  ],
  "prCreation": "not-pending",
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "pinDigests": true,
  "nix": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "automerge": true,
    "groupName": "security updates",
    "commitMessageTopic": "security updates"
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github-actions",
      "pinDigests": true,
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo dependencies",
      "commitMessageTopic": "Cargo dependencies"
    },
    {
      "description": "Keep multiaddr and libp2p-identity on the versions the older libp2p pins; a newer pair clashes with the Multiaddr and PeerId types of crates that use that libp2p",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["multiaddr", "libp2p-identity"],
      "enabled": false
    },
    {
      "description": "Keep parameterized on 2.0.0: parameterized 2.1.0 pulls parameterized-macro 3.0.0, which requires indexmap ~2.11.4, while the workspace and blokli-client 0.37.0 need indexmap >= 2.14, so no single indexmap version satisfies both. Remove this rule once parameterized-macro widens its indexmap range.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["parameterized"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": { "enabled": true }
}
