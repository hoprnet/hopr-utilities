.claude/

# Generated by Cargo
# will have compiled files and executables
debug
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# wasm-pack
bin/
pkg/
wasm-pack.log

# RustRover / JetBrains
#.idea/

# keep committed cargo config, ignore locally installed binaries
!/.cargo/config.toml
!/.cargo/audit.toml
/.cargo/

# nix generated files
result
/.direnv
/.pre-commit-config.yaml

*.log
